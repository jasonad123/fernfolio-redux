---
pagination:
  data: collections
  size: 1
  alias: tag
permalink: /project-tags/{{ tag }}/
layout: base.liquid
renderData:
  title: "Projects tagged “{{ tag }}”"
  metaDescription: "All projects tagged with “{{ tag }}”"
---
<div class="page-container">
  {% comment %} Header {% endcomment %}
  <div class="tag-list tag-list--no-wrap">
    <h1 class="tag-list__title">Projects Tagged: "{{ tag | capitalize }}"</h1>
    <a class="btn btn--sm btn--danger" href="/projects">Remove Tag</a>
  </div>

  {% comment %} Projects {% endcomment %}
  {% assign taggedProjects = collections[tag] | reverse %}
  {% render "partials/projectlist.liquid", projects: taggedProjects, heading_level: 2 %}

  {% comment %} Footer {% endcomment %}
  <nav>
    <a href="{{ '/projects/' | url }}">← View All Projects</a>
  </nav>
</div>
