---
layout: base.liquid
section: home
---
<div class="home-page">
	<div class="home-page__bg-square"></div>

  {% comment %} Hero {% endcomment %}
  <div class="hero">
    <div class="hero__col">
      <h1 class="hero__title gradient-text">{{ home.title }}</h1>
      {% if home.body %}
        <div class="hero__body">{{ home.body | markdown | raw }}</div>
      {% endif %}
    </div>
    <div class="hero__col">
    <img src="{{ home.image }}" alt="{{ home.image_alt }}" class="hero__image shadow" loading="eager" sizes="(min-width: 1024px) 50vw, 100vw">
    </div>
  </div>

  {% comment %} Projects {% endcomment %}
  <div class="list-header">
    <h2 class="list-header__title">Projects</h2>
    <a class="btn btn--outline btn--sm" href="/projects">View All</a>
  </div>
  {% assign homeProjects = collections.project | reverse %}
  {% render "partials/projectlist.liquid", projects: homeProjects %}

  {% comment %} Articles {% endcomment %}
  <div class="list-header">
    <h2 class="list-header__title">Articles</h2>
    <a class="btn btn--outline btn--sm" href="/blog">View All</a>
  </div>
  {% assign homeArticles = collections.post | reverse %}
  {% render "partials/articlelist.liquid", articles: homeArticles, show_tags: false, limit: 3 %}
</div>
